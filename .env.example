# Server-only. Configure these in Vercel project settings, never NEXT_PUBLIC_*.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Required to enable paid Qwen calls in production; atomic shared 15/minute/IP limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Separate Python service with a trained checkpoint and observed demand bundle.
MODEL_SERVICE_URL=
MODEL_SERVICE_TOKEN=
# Optional authorized JSON adapter, unused when absent. Not a scraped Citizen endpoint.
CITIZEN_FEED_URL=
CITIZEN_API_KEY=
