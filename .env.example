# Browser-safe project identity. Add BEFORE build/deploy; Next.js embeds these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# All remaining credentials are SERVER ONLY. Never prefix them NEXT_PUBLIC_.
# Accepts a modern Supabase sb_secret_ key or legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Generate each separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAINTENANCE_TOKEN=
RATE_LIMIT_SALT=
# Local maintenance command / GitHub Actions variable (your deployed HTTPS URL).
URBANFLOW_URL=

# Cloudflare Workers AI token. The existing QWEN_* names also support other
# OpenAI-compatible providers. Paste actual values in Vercel or .env.local.
QWEN_API_KEY=
QWEN_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
QWEN_MODEL=@cf/qwen/qwen3.8-27b
# Optional separate key/base. Otherwise reuses Qwen key/base. Vectors: 1024 dimensions.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
# Optional alternative for PUBLIC chat limits. Private limits always use Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# estimate (default): current-date estimate, historical reference + recent weather.
# replay: explicitly select historical input. live: requires observed-data service.
FORECAST_MODE=estimate
MODEL_SERVICE_URL=
MODEL_SERVICE_TOKEN=
# Only used with FORECAST_MODE=replay. Old settings do not activate replay by default.
COLAB_HISTORICAL_INPUT_GZIP=
# Optional authorized Citizen adapter. Omit to use only official MTA + DOT.
CITIZEN_FEED_URL=
CITIZEN_API_KEY=
# Custom HTTPS OSRM-compatible route service; takes precedence over Mapbox if set.
ROUTING_SERVICE_URL=
MAPBOX_ACCESS_TOKEN=
# Public noncommercial Open-Meteo is the default; use a commercial key if required.
OPEN_METEO_API_KEY=
