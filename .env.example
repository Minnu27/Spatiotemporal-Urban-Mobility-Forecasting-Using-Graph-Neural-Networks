# Server-only. Configure these in Vercel project settings, never NEXT_PUBLIC_*.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Required to enable paid Qwen calls in production; atomic shared 15/minute/IP limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Separate Python service with a trained checkpoint and observed demand bundle.
MODEL_SERVICE_URL=
MODEL_SERVICE_TOKEN=
# Optional authorized JSON adapter, unused when absent. Not a scraped Citizen endpoint.
CITIZEN_FEED_URL=
CITIZEN_API_KEY=
# HTTPS base URL of an OSRM-compatible driving service for automatic zone-to-zone fares.
ROUTING_SERVICE_URL=

# Server-only Mapbox public token used for Directions when ROUTING_SERVICE_URL is empty.
MAPBOX_ACCESS_TOKEN=

# Base64-encoded gzip JSON of the trusted held-out Colab input (server-only).
# Required for historical ONNX replay when MODEL_SERVICE_URL/TOKEN are absent.
COLAB_HISTORICAL_INPUT_GZIP=

# Optional server-only commercial Open-Meteo key. Without a key, the application
# uses the public noncommercial API. No weather key is sent to the browser.
OPEN_METEO_API_KEY=
